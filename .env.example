# Ask Farhan — server-side only. NEVER prefix these with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: override the API base URL
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Public site URL for canonical links / Open Graph / sitemap. Set on Vercel once your domain exists.
# (Without it, Vercel's production URL is used automatically.)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
